# Supabase — public
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Supabase — server only (JAMAIS committer, JAMAIS exposer côté client)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Connecteur MCP — signature des jetons d'accès OAuth.
# Générer avec : openssl rand -base64 48
# Changer cette valeur invalide tous les connecteurs déjà branchés.
MCP_JWT_SECRET=

# URL publique du déploiement, utilisée comme émetteur OAuth et comme
# identifiant de ressource. Sur Vercel elle est déduite automatiquement ;
# à renseigner en local ou derrière un domaine personnalisé.
# MCP_PUBLIC_URL=https://votre-domaine.fr
